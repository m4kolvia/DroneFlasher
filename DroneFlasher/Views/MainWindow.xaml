<Window x:Class="DroneFlasher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DroneFlasher.ViewModels"
        xmlns:helpers="clr-namespace:DroneFlasher.Helpers"
        Title="Рука допомоги" 
        Height="540" Width="980"
        Background="#141416" Foreground="#E1E1E6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>

        <!-- Стиль полів вводу -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#222328"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#32343D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок із вбудованим блюром та деактивацією під час IsBusy -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2B2D35"/>
            <Setter Property="Foreground" Value="#E6E6EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="6" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383A45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1F24"/>
                            </Trigger>

                            <!-- Стан, коли йде завантаження (сірий вигляд) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2A2B30"/>
                                <Setter Property="Foreground" Value="#656770"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Ліва частина: Панель налаштувань -->
            <ColumnDefinition Width="460"/>
            <!-- Розділювач -->
            <ColumnDefinition Width="16"/>
            <!-- Права частина: Консоль польотника -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛІВА КОЛОНКА -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Прошивка -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="1. Файл прошивки" Foreground="#A0A0B0" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="(.hex)" Foreground="#70707D" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Тест DFU" Command="{Binding TestDfuCommand}"
                            Background="Transparent" Foreground="#60A5FA" FontSize="11" Cursor="Hand" BorderThickness="0"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FirmwarePath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Огляд..." Style="{StaticResource ModernButton}" 
                            Command="{Binding SelectFirmwareCommand}" Margin="10,0,0,0" Padding="16,8"/>
                </Grid>
            </StackPanel>

            <!-- 2. Конфігурація -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="2. Конфігурація (Dump / Diff / Backup)" Foreground="#A0A0B0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding DumpPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Огляд..." Style="{StaticResource ModernButton}" 
                            Command="{Binding SelectDumpCommand}" Margin="10,0,0,0" Padding="16,8"/>
                </Grid>
            </StackPanel>

            <!-- 3. Автозапуск та ручний пуск -->
            <Border Grid.Row="2" Background="#1B1C21" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#262830" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsAutoFlashEnabled}" VerticalContentAlignment="Center" Cursor="Hand">
                        <TextBlock Text="Автозавантаження" FontSize="13" FontWeight="SemiBold" Foreground="#EDEDF2"/>
                    </CheckBox>
                    <!-- Кнопка автоматично дизейблиться через CanExecute і блюриться тригером у стилі -->
                    <Button Grid.Column="1" Content="Запустити" Style="{StaticResource ModernButton}" 
                            Command="{Binding ManualFlashCommand}" Background="#2563EB" Foreground="#FFFFFF" Padding="16,6" FontSize="12"/>
                </Grid>
            </Border>

            <!-- 4. Статус картка -->
            <Border Grid.Row="3" Background="#1A1B22" CornerRadius="8" BorderThickness="1.5" 
                    BorderBrush="{Binding StatusBrush}" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Border Background="{Binding StatusBrush}" Opacity="0.07" CornerRadius="7"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="15" 
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="16"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ПРАВА КОЛОНКА: Консоль CLI -->
        <Border Grid.Column="2" Background="#0C0D0E" CornerRadius="8" BorderBrush="#23242B" BorderThickness="1">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка консолі -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CLI Консоль" FontWeight="Bold" FontSize="12" Foreground="#8B8D98"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Копіювати"
            Command="{Binding CopyLogCommand}"
            Background="Transparent"
            Foreground="#60A5FA"
            FontSize="11"
            Cursor="Hand"
            BorderThickness="0"
            Margin="0,0,12,0"/>

                        <Button Content="Очистити"
            Command="{Binding ClearLogCommand}"
            Background="Transparent"
            Foreground="#71717A"
            FontSize="11"
            Cursor="Hand"
            BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- Тіло консолі з автоскролом -->
                <ListBox x:Name="ConsoleListBox"
                         Grid.Row="1" 
                         ItemsSource="{Binding LogEntries}"
                         helpers:ListBoxBehavior.AutoScroll="True"
                         Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" 
                                       FontFamily="Consolas" FontSize="11" Margin="0,1" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>